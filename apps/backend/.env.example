DATABASE_URL="mysql://root:secret@localhost:3306/lti_db"

# Optional seed variables for testing Canvas course generation (used by prisma/seed.ts)
# SEED_CANVAS_URL="https://canvas.instructure.com"
# SEED_CANVAS_COURSE_ID="12345"
# SEED_CANVAS_API_KEY="your_canvas_api_token"
# SEED_LTI_CONSUMER_KEY="opendsa_consumer_key"
# SEED_LTI_CONSUMER_SECRET="opendsa_consumer_secret"

# Optional: maximum time to wait for a book compile, in milliseconds.
# COMPILER_TIMEOUT_MS=600000
# Optional OpenDSA service overrides. simple2full is derived from CONFIG_API_LINK
# when left unset; BOOKS_PUBLIC_URL is where compiled HTML is served.
# CONFIG_API_LINK="http://opendsa:8080/api/configure/"
# SIMPLE2FULL_API_LINK="http://opendsa:8080/api/simple2full/"
# BOOKS_PUBLIC_URL="http://localhost:8080/Books"
# Optional LTI 1.3 route overrides (defaults are under /api so the ingress
# and Vite /api proxy already cover them). The LMS developer key must use the
# same login/launch/keyset URLs.
# LTI13_LOGIN_ROUTE="/api/lti13/login_initiations"
# LTI13_LAUNCH_ROUTE="/api/lti13/launches"
# LTI13_KEYSET_ROUTE="/api/lti13/keys"
# LTI13_SESSION_ROUTE="/api/lti13/session"


# Optional: initial password for seeded staff with empty password hashes only.
# Local development only; choose your own value, 8–72 UTF-8 bytes.
# SEED_AUTH_PASSWORD=""
# Optional Devise-compatible pepper, shared by seed and login. Keep private.
# Set before creating passwords; changing it requires resetting test passwords.
# PASSWORD_PEPPER=""
# Cookie encryption secret: at least 32 characters. Keep stable across restarts.
# Required in production; development generates a temporary value if omitted.
# SESSION_SECRET=""
# Trusted reverse-proxy hops: 0 locally, 1 for Discovery's ingress -> backend.
# TRUST_PROXY_HOPS="0"
