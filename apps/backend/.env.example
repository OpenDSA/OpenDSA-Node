DATABASE_URL="mysql://root:secret@localhost:3306/lti_db"

# Optional seed variables for testing Canvas course generation (used by prisma/seed.ts)
# SEED_CANVAS_URL="https://canvas.instructure.com"
# SEED_CANVAS_COURSE_ID="12345"
# SEED_CANVAS_API_KEY="your_canvas_api_token"
# SEED_LTI_CONSUMER_KEY="opendsa_consumer_key"
# SEED_LTI_CONSUMER_SECRET="opendsa_consumer_secret"


# Optional: initial password for seeded staff with empty password hashes only.
# Local development only; choose your own value, 8–72 UTF-8 bytes.
# SEED_AUTH_PASSWORD=""
# Optional stable development session signing key; otherwise generated at startup.
# SESSION_SECRET=""
